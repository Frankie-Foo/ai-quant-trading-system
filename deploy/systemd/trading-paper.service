[Unit]
Description=Trading System v2 causal Alpaca Paper session
Wants=network-online.target
After=network-online.target trading-premarket.service
ConditionPathExists=/opt/trading-system/.venv/bin/python
OnFailure=trading-alert@paper.service
StartLimitIntervalSec=3600
StartLimitBurst=30

[Service]
Type=simple
User=trading
Group=trading
WorkingDirectory=/opt/trading-system
EnvironmentFile=/etc/trading-system/trading-system.env
Environment=PYTHONUNBUFFERED=1
StateDirectory=trading-system
RuntimeDirectory=trading-system
UMask=0077
ExecStart=/opt/trading-system/.venv/bin/python -m scripts.run_paper_session --data-root /var/lib/trading-system/data --sip-db /var/lib/trading-system/state/sip-stream.sqlite3 --order-db /var/lib/trading-system/state/paper-orders.sqlite3 --readiness-evidence /var/lib/trading-system/state/maturity-evidence.json --lock-file /run/trading-system/paper-session.lock --sip-lock-file /run/trading-system/alpaca-sip.lock
Restart=on-failure
RestartSec=60
TimeoutStartSec=8h
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/trading-system /run/trading-system
ExecStartPre=/opt/trading-system/.venv/bin/python -m scripts.verify_alpaca_access --symbols AAPL --lock-file /run/trading-system/alpaca-sip.lock --receipt /var/lib/trading-system/state/alpaca-access-receipt.json --evidence /var/lib/trading-system/state/maturity-evidence.json --data-root /var/lib/trading-system/data --order-db /var/lib/trading-system/state/paper-orders.sqlite3
ExecStartPre=/opt/trading-system/.venv/bin/python -m scripts.refresh_maturity_evidence --data-root /var/lib/trading-system/data --order-db /var/lib/trading-system/state/paper-orders.sqlite3 --evidence /var/lib/trading-system/state/maturity-evidence.json
