[Unit]
Description=Trading System v2 point-in-time premarket selection
Wants=network-online.target
After=network-online.target
OnFailure=trading-alert@premarket.service
ConditionPathExists=/opt/trading-system/.venv/bin/python

[Service]
Type=oneshot
User=trading
Group=trading
WorkingDirectory=/opt/trading-system
EnvironmentFile=/etc/trading-system/trading-system.env
Environment=PYTHONUNBUFFERED=1
StateDirectory=trading-system
RuntimeDirectory=trading-system
UMask=0077
ExecStart=/opt/trading-system/.venv/bin/python -m schedule.premarket --data-root /var/lib/trading-system/data --state-db /var/lib/trading-system/state/jobs.sqlite3 --lock-file /run/trading-system/premarket.lock
TimeoutStartSec=75min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/trading-system /run/trading-system
