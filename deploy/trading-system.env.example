# Install as /etc/trading-system/trading-system.env with mode 0600.
# Never put this file in the repository after adding real values.
CLOUD_PLATFORM_BASE_URL=https://cloud-strategy-platform.example.internal
CLOUD_MARKET_DATA_API_TOKEN=
CLOUD_PAPER_API_TOKEN=
CLOUD_FEATURE_API_TOKEN=
# Production keeps the cloud proxy explicit; local research defaults to Alpaca direct.
MARKET_DATA_PROVIDER=cloud_proxy
# The cloud service owns licensed Alpaca SIP; this process owns no Alpaca credential.
CLOUD_MARKET_DATA_FEED=sip
MASSIVE_API_KEY=
SEC_USER_AGENT=
DEEPSEEK_API_KEY=
BROKER_WRITE_ENABLED=false
TRADING_KILL_SWITCH=true
ALERT_WEBHOOK_URL=
# Optional production agent fact store. Keep credentials only in the server environment.
QUANT_AGENT_POSTGRES_DSN=
# Set one role per MCP server process in production; blank is development-only shared mode.
QUANT_AGENT_NAME=
QUANT_AGENT_DATA_ROOT=/var/lib/trading-system/data
QUANT_AGENT_STATE_DB=/var/lib/trading-system/state/agent-facts.sqlite3
QUANT_AGENT_ORDER_LEDGER=/var/lib/trading-system/state/orders.sqlite3
# Use a stable private value so anonymous case IDs are consistent without exposing tickers.
QUANT_AGENT_ANONYMIZATION_SALT=
