POLYGON_API_KEY=
MASSIVE_API_KEY=
# Primary market-data path. Use cloud_proxy only as an explicit fallback.
MARKET_DATA_PROVIDER=alpaca_direct
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
CLOUD_PLATFORM_BASE_URL=https://cloud-strategy-platform.example.internal
CLOUD_MARKET_DATA_API_TOKEN=
CLOUD_PAPER_API_TOKEN=
CLOUD_FEATURE_API_TOKEN=
CLOUD_MARKET_DATA_FEED=sip
# Local-only fallback. Never place these values in deploy/trading-system.env.example.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=
BROKER_WRITE_ENABLED=false
TRADING_KILL_SWITCH=true
SEC_USER_AGENT=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ALERT_WEBHOOK_URL=
VPS_LIVERMORE_APP_ID=
VPS_LIVERMORE_APP_SECRET=
VPS_LIVERMORE_CHANNEL_ID=
VPS_BUFFETT_APP_ID=
VPS_BUFFETT_APP_SECRET=
VPS_BUFFETT_CHANNEL_ID=
VPS_TARGET_MONITOR_MODE=exit_only
# Investment Base: four allowlisted tables. 运行ID is the writable idempotency key in this Base.
FEISHU_INVESTMENT_BASE_TOKEN=
FEISHU_INVESTMENT_BASE_TOKEN_SHA256=
FEISHU_INVESTMENT_SELECTION_TABLE_ID=tblhiZltBrhHr0Na
FEISHU_INVESTMENT_MONITOR_TABLE_ID=tblblUt2GRBPoGxG
FEISHU_INVESTMENT_TRADE_TABLE_ID=tblMRjjjMxgUm25Z
FEISHU_INVESTMENT_REVIEW_TABLE_ID=tblWTj5tXQ3HoxW1
FEISHU_INVESTMENT_EVENT_ID_FIELD=运行ID
FEISHU_INVESTMENT_LOCK_DB=runs/feishu-investment-events.sqlite3
FEISHU_INVESTMENT_AUDIT_REQUIRED=false
POSTGRES_DSN=
# Optional PAPER-only Loop Platform review integration. Keep secrets in the
# machine secret store or deployment Secret, never in this example file.
AI_QUANT_LOOP_SYNC_ENABLED=false
AI_QUANT_LOOP_BINDING_FILE=
# Delayed Outcome generation is a separate fail-closed switch. The referenced
# file must contain risk-owner-approved cost/slippage assumptions.
AI_QUANT_LOOP_OUTCOME_SYNC_ENABLED=false
AI_QUANT_LOOP_OUTCOME_CONFIG_FILE=
# Public machine endpoint; the Gateway exposes only the quant integration allowlist.
LOOP_BASE_URL=https://aisales-v2.vertu.cn/api/v1/loop/machine
LOOP_RUNTIME_API_KEY=
